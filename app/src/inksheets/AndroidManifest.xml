<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The tuner listens through the microphone. Asked for only when the tuner is opened. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keeps Wi-Fi out of power saving while playing together, so page turns arrive at once. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Play together over Bluetooth (experimental, off unless turned on): broadcasts to nearby
         devices and listening for theirs. Never used to find where anyone is. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        xmlns:tools="http://schemas.android.com/tools" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- A remote over Bluetooth, with devices paired in the system's settings: round a Wi-Fi
         (eduroam) that will not carry the connection. Asked for only when used. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Controllers: a foot controller or a POD Go over USB, sending MIDI. Not needed to install. -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <!-- A POD Go's footswitches and pedal over USB (it does not send them as MIDI). Not needed to install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application>
        <!-- Scanning a leader's join code with the tablet's own camera app opens InkSheets and follows; a device's remote code makes this one its remote. -->
        <activity android:name="com.inkslate.MainActivity" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="inksheets" android:host="join" />
                <data android:scheme="inksheets" android:host="remote" />
            </intent-filter>
            <!-- Music shared from another app, one file or many, and downloads of whole folders. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
